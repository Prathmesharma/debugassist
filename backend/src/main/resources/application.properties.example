spring.application.name=debugassist
server.port=8080

# Database - read from env vars with defaults
# DB_URL: Database connection string (default: jdbc:postgresql://localhost:5432/debugassist)
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/debugassist}
# DB_USERNAME: Database username (default: postgres)
spring.datasource.username=${DB_USERNAME:postgres}
# DB_PASSWORD: Database password (default: postgres)
spring.datasource.password=${DB_PASSWORD:postgres}
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true

# AI Configuration
# AI_PROVIDER: AI provider name (default: gemini)
ai.provider=${AI_PROVIDER:gemini}
# GEMINI_API_KEY: Gemini API Key for log analysis
ai.gemini.api-key=${GEMINI_API_KEY:your-gemini-api-key-here}
# GEMINI_MODEL: Gemini model to use (default: gemini-2.0-flash)
ai.gemini.model=${GEMINI_MODEL:gemini-2.0-flash}
ai.gemini.api-url=https://generativelanguage.googleapis.com/v1beta/models

# Log Analysis
# MAX_LOG_SIZE_MB: Maximum log file size in MB (default: 20)
analysis.max-log-size-mb=${MAX_LOG_SIZE_MB:20}
# MAX_EXCERPT_LINES: Maximum number of log lines to extract (default: 300)
analysis.max-excerpt-lines=${MAX_EXCERPT_LINES:300}
# CONTEXT_LINES: Number of surrounding context lines to include (default: 5)
analysis.context-lines=${CONTEXT_LINES:5}

# Jackson
spring.jackson.serialization.write-dates-as-timestamps=false
